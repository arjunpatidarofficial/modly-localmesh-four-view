{
  "id": "localmesh-four-view",
  "name": "LocalMesh Four View",
  "type": "model",
  "source": "https://github.com/arjunpatidarofficial/modly-localmesh-four-view",
  "description": "Front image plus right, left and back paths to generate a GLB with a separately installed LocalMesh Engine.",
  "version": "0.1.0",
  "author": "Community adapter",
  "generator_class": "LocalMeshFourViewGenerator",
  "tags": ["image-to-3d", "multi-view"],
  "nodes": [{
    "id": "generate",
    "name": "Generate four-view mesh",
    "input": "image",
    "output": "mesh",
    "params_schema": [
      {"id": "right_image_path", "label": "Right image path", "type": "string", "default": "", "pickerIntent": "image"},
      {"id": "left_image_path", "label": "Left image path", "type": "string", "default": "", "pickerIntent": "image"},
      {"id": "back_image_path", "label": "Back image path", "type": "string", "default": "", "pickerIntent": "image"},
      {"id": "python_exe", "label": "LocalMesh Python executable", "type": "string", "default": ""},
      {"id": "tier", "label": "Quality", "type": "select", "default": "standard", "options": [{"value":"draft","label":"Draft"},{"value":"standard","label":"Standard"},{"value":"high","label":"High"}]},
      {"id": "seed", "label": "Seed (-1 random)", "type": "int", "default": -1, "min": -1, "max": 4294967295}
    ]
  }]
}
